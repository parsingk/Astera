<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8's JIT. Every Electron app needs this, without exception. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- node-pty dlopens/execs a .node and spawn-helper living outside the asar (app.asar.unpacked).
       Hardened Runtime's library validation sees this as 'code from a different team' and blocks it. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The shuttle script sets ELECTRON_RUN_AS_NODE to re-run the app binary as node
       (main/orchestration/shuttle.ts). Hardened Runtime strips env vars like this by default. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
