{
  "name": "@astera-app/client",
  "version": "0.5.0",
  "description": "TypeScript client for the Astera Host: Jobs, Runs, Tasks, questions, completion and events.",
  "keywords": [
    "astera",
    "sdk",
    "client",
    "agents"
  ],
  "homepage": "https://github.com/parsingk/Astera/blob/main/docs/sdk.md",
  "bugs": {
    "url": "https://github.com/parsingk/Astera/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/build-packages.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parsingk/Astera.git",
    "directory": "packages/client"
  }
}
