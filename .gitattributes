# Normalise line endings. Text files are stored as LF in the repository and checked out as LF; without
# this rule a working tree on either platform this project is developed on — Windows and macOS — could
# leak CRLF into the history.
* text=auto eol=lf

# Windows scripts have to keep CRLF: a .ps1 read by Windows PowerShell 5.1 can misparse LF-only files.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaries — never touched, and never shown as diffable text.
*.png binary
*.ico binary
*.icns binary
